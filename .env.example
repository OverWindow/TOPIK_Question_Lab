# ChatKHU 웹 수동 모드는 키 없이 사용할 수 있습니다.
# 개발자 설정에서 Gateway 키 발급이 허용된 계정만 아래 값을 입력하세요.
CHATKHU_API_KEY=
CHATKHU_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
CHATKHU_WEB_URL=https://chat.khu.ac.kr

# DeepSeek 공식 API는 ChatKHU와 별도 과금됩니다.
# https://platform.deepseek.com/api_keys 에서 발급한 키를 입력하세요.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_WEB_URL=https://chat.deepseek.com
