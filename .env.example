# BizRouter text and image generation (separate from ChatKHU)
BIZROUTER_API_KEY=
BIZROUTER_BASE_URL=https://api.bizrouter.ai/v1
BIZROUTER_IMAGE_MODEL=google/gemini-nano-banana-2.1

# ChatKHU 웹 수동 모드는 키 없이 사용할 수 있습니다.
# 개발자 설정에서 Gateway 키 발급이 허용된 계정만 아래 값을 입력하세요.
CHATKHU_API_KEY=
CHATKHU_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
CHATKHU_WEB_URL=https://chat.khu.ac.kr

# DeepSeek 공식 API는 ChatKHU와 별도 과금됩니다.
# https://platform.deepseek.com/api_keys 에서 발급한 키를 입력하세요.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_WEB_URL=https://chat.deepseek.com

# 최종 승인 문항을 모델·영역별 50문항 세트로 발행할 PostgreSQL입니다.
# 비밀번호가 포함되므로 실제 값은 .env에만 두고 커밋하지 마세요.
DATABASE_URL=postgresql://bank_admin:password@127.0.0.1:5434/topik_bank

# Hub → Django 서버 DB 단방향 복사 대상입니다. 원본과 다른 DB를 지정하세요.
QUESTION_BANK_LOCAL_DATABASE_URL=
QUESTION_BANK_PRODUCTION_DATABASE_URL=

# 로컬 완성 검증에 사용할 미디어 파일 디렉터리입니다.
LOCAL_MEDIA_ROOT=data/media

# S3 / CloudFront 미디어 검증. AWS 인증은 표준 프로필/환경변수 체인을 사용합니다.
AWS_REGION=ap-northeast-2
AWS_PROFILE=
S3_BUCKET=
CLOUDFRONT_BASE_URL=

# 세트 완전 삭제 시 S3 버전 삭제 및 CloudFront 캐시 무효화에 사용합니다.
# 선택 사항: 비워 두면 CLOUDFRONT_BASE_URL로 배포를 자동 조회합니다(cloudfront:ListDistributions 권한 필요).
CLOUDFRONT_DISTRIBUTION_ID=
# Supabase에 남은 과거 음원·이미지 삭제가 필요한 경우에만 설정합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google TTS 음원 생성. 서비스 계정 JSON 또는 Google ADC를 사용합니다.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CREDENTIALS_JSON=
GOOGLE_TTS_MODEL=gemini-2.5-flash-tts
GOOGLE_TTS_FEMALE_VOICE=Aoede
GOOGLE_TTS_MALE_VOICE=Charon
# 이전 Google 이미지 작업은 저장 당시 모델·위치로 재개됩니다.
# PATH에 설치되어 있으면 생략할 수 있습니다.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
